<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Prompt Video Creator Studio</title>
  <style>
    :root {
      --bg-color: #0b0f19;
      --card-bg: #151c2c;
      --accent: #818cf8;
      --accent-hover: #6366f1;
      --text: #f3f4f6;
      --border: #1f293d;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
    body { background-color: var(--bg-color); color: var(--text); padding: 15px; }

    header { text-align: center; margin-bottom: 20px; }
    header h1 { color: var(--accent); font-size: 2.2rem; margin-bottom: 5px; }
    header p { color: #9ca3af; font-size: 0.95rem; }

    .app-container {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
      max-width: 1300px;
      margin: 0 auto;
    }

    @media (min-width: 900px) {
      .app-container { grid-template-columns: 400px 1fr; }
    }

    .panel {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.4);
    }

    .form-group { margin-bottom: 15px; }
    label { display: block; font-size: 0.85rem; font-weight: 600; color: #cbd5e1; margin-bottom: 6px; }
    
    input[type="text"], textarea, select, input[type="range"] {
      width: 100%; padding: 10px; border-radius: 6px; border: 1px solid var(--border);
      background: #0b0f19; color: #fff; outline: none; font-size: 0.9rem;
    }

    .btn {
      background: var(--accent); color: #000; border: none; padding: 12px 16px;
      font-weight: 700; border-radius: 8px; cursor: pointer; width: 100%; transition: 0.2s;
      display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .btn:hover { background: var(--accent-hover); color: #fff; }
    .btn-secondary { background: #334155; color: #fff; }
    .btn-secondary:hover { background: #475569; }
    .btn-success { background: #10b981; color: #fff; }
    .btn-success:hover { background: #059669; }

    /* Canvas Preview Area */
    .preview-container { display: flex; flex-direction: column; align-items: center; width: 100%; }
    .canvas-wrapper {
      position: relative; width: 100%; max-width: 720px; aspect-ratio: 16/9;
      background: #000; border-radius: 12px; overflow: hidden; border: 2px solid var(--border);
    }
    canvas { width: 100%; height: 100%; object-fit: contain; }

    /* Themes Filters */
    .filter-none { filter: none; }
    .filter-cinematic { filter: contrast(115%) saturate(130%) brightness(95%); }
    .filter-cyberpunk { filter: hue-rotate(180deg) saturate(200%) contrast(120%); }
    .filter-vintage { filter: sepia(60%) contrast(90%); }
    .filter-anime { filter: saturate(180%) contrast(110%); }

    /* Action Controls */
    .action-bar { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; width: 100%; max-width: 720px; margin-top: 15px; }

    /* Storyboard Output */
    .storyboard {
      width: 100%; max-width: 720px; margin-top: 20px; background: #0b0f19;
      padding: 15px; border-radius: 8px; border: 1px solid var(--border);
    }
    .scene-list { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 10px; margin-top: 10px; }
    .scene-card {
      min-width: 140px; background: var(--card-bg); border: 2px solid var(--border);
      padding: 10px; border-radius: 8px; cursor: pointer; text-align: center;
    }
    .scene-card.active { border-color: var(--accent); background: #1e1b4b; }
  </style>
</head>
<body>

  <header>
    <h1>✨ AI Prompt-to-Video Creator Studio</h1>
    <p>केवल एक AI प्रॉम्प्ट लिखें और ऑटोमैटिक वीडियो जनरेट करें</p>
  </header>

  <div class="app-container">
    <!-- Prompt Input Panel -->
    <div class="panel">
      <h3>🤖 AI Video Prompt Generator</h3>
      <br>

      <div class="form-group">
        <label>1. अपना AI प्रॉम्प्ट या कहानी लिखें:</label>
        <textarea id="aiPrompt" rows="4" placeholder="उदाहरण: A space astronaut discovering a hidden glowing crystal on Mars and speaking about human civilization."></textarea>
      </div>

      <div class="form-group">
        <label>2. वीडियो स्टाइल / Visual Style:</label>
        <select id="styleSelect">
          <option value="filter-cinematic">Cinematic Movie</option>
          <option value="filter-cyberpunk">Cyberpunk Sci-Fi</option>
          <option value="filter-anime">3D Anime World</option>
          <option value="filter-vintage">Vintage Retro</option>
          <option value="filter-none">Standard Realistic</option>
        </select>
      </div>

      <div class="form-group">
        <label>3. वॉयसओवर स्टाइल (Voice Style):</label>
        <select id="voiceSelect"></select>
      </div>

      <div class="form-group">
        <label>4. वॉयस स्पीड (Voice Speed):</label>
        <input type="range" id="voiceRate" min="0.6" max="1.4" step="0.1" value="1">
      </div>

      <button class="btn" id="generateBtn">🚀 AI से वीडियो जनरेट करें</button>
    </div>

    <!-- Canvas Preview Area -->
    <div class="preview-container panel">
      <div class="canvas-wrapper" id="canvasWrapper">
        <canvas id="videoCanvas" width="1280" height="720"></canvas>
      </div>

      <div class="action-bar">
        <button class="btn" id="playAllBtn">▶️ प्ले वीडियो</button>
        <button class="btn btn-success" id="exportBtn">⬇️ डाउनलोड (.WebM)</button>
        <button class="btn btn-secondary" id="shareBtn">🔗 शेयर करें</button>
      </div>

      <!-- Generated Storyboard Queue -->
      <div class="storyboard">
        <h4>🎬 AI जनरेटेड सीन्स (Storyboard Queue)</h4>
        <p style="font-size: 0.8rem; color: #94a3b8;">प्रॉम्प्ट के आधार पर ऑटो-क्रिएटेड सीन्स नीचे दिए गए हैं:</p>
        <div class="scene-list" id="sceneList"></div>
      </div>
    </div>
  </div>

  <script>
    const canvas = document.getElementById('videoCanvas');
    const ctx = canvas.getContext('2d');
    const canvasWrapper = document.getElementById('canvasWrapper');
    
    let scenes = [];
    let currentSceneIndex = 0;
    let synth = window.speechSynthesis;
    let voices = [];

    // Populate Available Voices
    function populateVoices() {
      voices = synth.getVoices();
      const voiceSelect = document.getElementById('voiceSelect');
      voiceSelect.innerHTML = '';
      voices.forEach((voice, i) => {
        const option = document.createElement('option');
        option.textContent = `${voice.name} (${voice.lang})`;
        option.value = i;
        voiceSelect.appendChild(option);
      });
    }
    populateVoices();
    if (speechSynthesis.onvoiceschanged !== undefined) {
      speechSynthesis.onvoiceschanged = populateVoices;
    }

    // Default Fallback Color Backdrops
    const bgGradients = [
      ["#0f172a", "#1e1b4b"],
      ["#1e293b", "#0f766e"],
      ["#311042", "#000000"],
      ["#1e3a8a", "#1e1b4b"]
    ];

    // AI Prompt Parser (Converts Prompt into Dynamic Scenes)
    document.getElementById('generateBtn').addEventListener('click', () => {
      const promptText = document.getElementById('aiPrompt').value.trim();
      if (!promptText) {
        alert("कृपया वीडियो जनरेट करने के लिए एक प्रॉम्प्ट दर्ज करें!");
        return;
      }

      const style = document.getElementById('styleSelect').value;
      const voiceIndex = document.getElementById('voiceSelect').value;
      const rate = document.getElementById('voiceRate').value;

      // Simple Natural Sentence Parsing (Generates Storyboard Scenes)
      const sentences = promptText.match(/[^.!?]+[.!?]+/g) || [promptText];
      
      scenes = sentences.map((sentence, index) => {
        return {
          text: sentence.trim(),
          voiceIndex: voiceIndex,
          rate: rate,
          filter: style,
          gradient: bgGradients[index % bgGradients.length]
        };
      });

      canvasWrapper.className = 'canvas-wrapper ' + style;
      updateStoryboardUI();
      if (scenes.length > 0) loadScene(0);
      alert(`AI ने आपकी प्रॉम्प्ट से ${scenes.length} सीन्स जनरेट किए हैं!`);
    });

    function updateStoryboardUI() {
      const sceneList = document.getElementById('sceneList');
      sceneList.innerHTML = '';
      scenes.forEach((sc, idx) => {
        const card = document.createElement('div');
        card.className = `scene-card ${idx === currentSceneIndex ? 'active' : ''}`;
        card.innerHTML = `<strong>Scene ${idx + 1}</strong><br><small>${sc.text.substring(0, 20)}...</small>`;
        card.onclick = () => loadScene(idx);
        sceneList.appendChild(card);
      });
    }

    function loadScene(index) {
      currentSceneIndex = index;
      const sc = scenes[index];
      canvasWrapper.className = 'canvas-wrapper ' + sc.filter;
      renderCanvas(sc.text, sc.gradient);
      updateStoryboardUI();
    }

    // Render Canvas Frame
    function renderCanvas(text = "", gradient = ["#0f172a", "#1e1b4b"], zoom = 1.0) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Procedural Background Animation Fill
      const grad = ctx.createLinearGradient(0, 0, canvas.width * zoom, canvas.height * zoom);
      grad.addColorStop(0, gradient[0]);
      grad.addColorStop(1, gradient[1]);
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Draw Center Abstract Visual Particle
      ctx.beginPath();
      ctx.arc(canvas.width / 2, canvas.height / 2 - 20, 100 * zoom, 0, 2 * Math.PI);
      ctx.fillStyle = "rgba(255, 255, 255, 0.08)";
      ctx.fill();

      // Subtitles Box & Render
      if (text) {
        ctx.fillStyle = "rgba(0, 0, 0, 0.75)";
        ctx.fillRect(60, canvas.height - 120, canvas.width - 120, 80);
        ctx.font = "bold 28px sans-serif";
        ctx.fillStyle = "#ffffff";
        ctx.textAlign = "center";
        ctx.fillText(text, canvas.width / 2, canvas.height - 70);
      }
    }

    // Play Sequential Video
    document.getElementById('playAllBtn').addEventListener('click', async () => {
      if (scenes.length === 0) { alert("पहले AI से वीडियो जनरेट करें!"); return; }

      for (let i = 0; i < scenes.length; i++) {
        loadScene(i);
        await playSceneAudio(scenes[i]);
      }
    });

    function playSceneAudio(scene) {
      return new Promise((resolve) => {
        const utterance = new SpeechSynthesisUtterance(scene.text);
        if (voices[scene.voiceIndex]) utterance.voice = voices[scene.voiceIndex];
        utterance.rate = scene.rate || 1;

        let animationFrame;
        let zoom = 1.0;
        let zoomDir = 0.0008;

        const animate = () => {
          zoom += zoomDir;
          if (zoom > 1.05 || zoom < 0.98) zoomDir *= -1;
          renderCanvas(scene.text, scene.gradient, zoom);
          animationFrame = requestAnimationFrame(animate);
        };
        animate();

        utterance.onend = () => {
          cancelAnimationFrame(animationFrame);
          renderCanvas(scene.text, scene.gradient, 1.0);
          resolve();
        };

        synth.speak(utterance);
      });
    }

    // Export Video (.WebM)
    document.getElementById('exportBtn').addEventListener('click', async () => {
      if (scenes.length === 0) { alert("वीडियो एक्सपोर्ट करने के लिए पहले प्रॉम्प्ट जनरेट करें!"); return; }

      const stream = canvas.captureStream(30);
      const recorder = new MediaRecorder(stream, { mimeType: 'video/webm' });
      const chunks = [];

      recorder.ondataavailable = e => chunks.push(e.data);
      recorder.onstop = () => {
        const blob = new Blob(chunks, { type: 'video/webm' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'AI_Prompt_Video.webm';
        a.click();
      };

      recorder.start();
      document.getElementById('playAllBtn').click();

      const checkInterval = setInterval(() => {
        if (!synth.speaking) {
          clearInterval(checkInterval);
          recorder.stop();
        }
      }, 1000);
    });

    // Share Options
    document.getElementById('shareBtn').addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({
            title: 'AI Prompt Video Creator Studio',
            text: 'मैंने AI Prompt से वीडियो बनाया है!',
            url: window.location.href,
          });
        } catch (err) { console.log('Share canceled'); }
      } else {
        navigator.clipboard.writeText(window.location.href);
        alert('वेब ऐप का लिंक क्लिपबोर्ड पर कॉपी हो गया है!');
      }
    });

    renderCanvas("यहाँ आपका AI प्रॉम्प्ट वीडियो दिखाई देगा");
  </script>
</body>
</html>
